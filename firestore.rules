rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 12 && code.matches('^[A-Z0-9]+$');
    }

    function isValidStringList(items, minSize, maxSize) {
      return items is list &&
             items.size() >= minSize &&
             items.size() <= maxSize &&
             (items.size() == 0 || items[0] is string);
    }

    function isValidVoiceNote(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() <= 80 &&
             data.workspaceId is string && data.workspaceId.size() <= 128 &&
             isValidStringList(data.memberUids, 1, 25) &&
             data.ownerId in data.memberUids &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.transcript is string && data.transcript.size() <= 15000 &&
             data.aiSummary is string && data.aiSummary.size() <= 2000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             isValidStringList(data.tags, 0, 8) &&
             isValidStringList(data.keywords, 0, 12) &&
             data.actionItem is string && data.actionItem.size() <= 500 &&
             data.priority in ['high', 'medium', 'low'] &&
             data.status in ['open', 'in_progress', 'closed'] &&
             data.resolutionNote is string && data.resolutionNote.size() <= 2000 &&
             data.resolvedByUid is string && data.resolvedByUid.size() <= 128 &&
             data.resolvedByName is string && data.resolvedByName.size() <= 80 &&
             data.assigneeName is string && data.assigneeName.size() <= 80 &&
             data.localAudioFileName is string && data.localAudioFileName.size() <= 200 &&
             data.audioDurationSec is int && data.audioDurationSec >= 0 && data.audioDurationSec <= 7200 &&
             data.dueAtMs is int && data.dueAtMs >= 0 &&
             data.reminderMinutesBefore is int && data.reminderMinutesBefore >= 0 && data.reminderMinutesBefore <= 10080 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('closedAt' in data) || (data.closedAt is timestamp && data.closedAt <= request.time));
    }

    function isValidWorkspace(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() <= 80 &&
             isValidInviteCode(data.joinCode) &&
             isValidStringList(data.memberUids, 1, 25) &&
             data.ownerId in data.memberUids &&
             isValidStringList(data.memberNames, 1, 25) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWorkspaceInvite(data) {
      return isValidId(data.workspaceId) &&
             data.workspaceName is string && data.workspaceName.size() >= 2 && data.workspaceName.size() <= 60 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // VoiceNotes Collection
    match /notes/{noteId} {
      allow get: if isSignedIn() &&
                    isValidId(noteId) &&
                    request.auth.uid in resource.data.memberUids;

      allow list: if isSignedIn() &&
                     request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(noteId) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().status in ['open', 'in_progress'] &&
                       !('closedAt' in incoming()) &&
                       incoming().keys().hasAll([
                         'ownerId', 'ownerName', 'workspaceId', 'memberUids',
                         'title', 'transcript', 'aiSummary', 'category',
                         'tags', 'keywords', 'actionItem', 'priority', 'status',
                         'resolutionNote', 'resolvedByUid', 'resolvedByName',
                         'assigneeName', 'localAudioFileName', 'audioDurationSec',
                         'dueAtMs', 'reminderMinutesBefore', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'ownerName', 'workspaceId', 'memberUids',
                         'title', 'transcript', 'aiSummary', 'category',
                         'tags', 'keywords', 'actionItem', 'priority', 'status',
                         'resolutionNote', 'resolvedByUid', 'resolvedByName',
                         'assigneeName', 'localAudioFileName', 'audioDurationSec',
                         'dueAtMs', 'reminderMinutesBefore', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidVoiceNote(incoming());

      allow update: if isSignedIn() &&
                       isValidId(noteId) &&
                       isValidVoiceNote(incoming()) &&
                       request.auth.uid in existing().memberUids &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Update note details / status before closing
                         (
                           existing().status != 'closed' &&
                           incoming().status in ['open', 'in_progress'] &&
                           !('closedAt' in incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'transcript', 'aiSummary', 'category',
                             'tags', 'keywords', 'actionItem', 'priority', 'status',
                             'assigneeName', 'dueAtMs', 'reminderMinutesBefore', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Resolve and close note (terminal state)
                         (
                           existing().status != 'closed' &&
                           incoming().status == 'closed' &&
                           incoming().resolutionNote.size() >= 1 &&
                           incoming().resolvedByUid == request.auth.uid &&
                           ('closedAt' in incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'status', 'resolutionNote', 'resolvedByUid',
                             'resolvedByName', 'closedAt', 'updatedAt'
                           ])
                         ) ||
                         // Action 3: Sync workspace team membership onto workspace note
                         (
                           existing().workspaceId.size() > 0 &&
                           incoming().workspaceId == existing().workspaceId &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'memberUids', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(noteId) &&
                       existing().ownerId == request.auth.uid;
    }

    // Workspaces Collection
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() &&
                    isValidId(workspaceId) &&
                    request.auth.uid in resource.data.memberUids;

      allow list: if isSignedIn() &&
                     request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(workspaceId) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().memberUids.size() == 1 &&
                       incoming().keys().hasAll([
                         'name', 'ownerId', 'ownerName', 'joinCode',
                         'memberUids', 'memberNames', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'name', 'ownerId', 'ownerName', 'joinCode',
                         'memberUids', 'memberNames', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidWorkspace(incoming());

      allow update: if isSignedIn() &&
                       isValidId(workspaceId) &&
                       isValidWorkspace(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().joinCode == existing().joinCode &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Owner renames workspace
                         (
                           existing().ownerId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
                         ) ||
                         // Action 2: Authenticated user joins via invite code (appends self to memberUids)
                         (
                           !(request.auth.uid in existing().memberUids) &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().memberUids.hasAll(existing().memberUids) &&
                           incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberNames', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(workspaceId) &&
                       existing().ownerId == request.auth.uid;
    }

    // Workspace Invites Lookup (Direct get by joinCode only; listing disabled)
    match /workspace_invites/{joinCode} {
      allow get: if isSignedIn() && isValidInviteCode(joinCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidInviteCode(joinCode) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['workspaceId', 'workspaceName', 'ownerId', 'createdAt']) &&
                       incoming().keys().hasOnly(['workspaceId', 'workspaceName', 'ownerId', 'createdAt']) &&
                       isValidWorkspaceInvite(incoming()) &&
                       existsAfter(/databases/$(database)/documents/workspaces/$(incoming().workspaceId));

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidInviteCode(joinCode) &&
                       existing().ownerId == request.auth.uid;
    }
  }
}
